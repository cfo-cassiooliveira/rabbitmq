# =====================================================================================
# Variáveis do docker-compose do RabbitMQ (modelo SEM valores reais).
# Recomendado: ./scripts/generate-env.sh  (gera o .env com segredos aleatórios e renderiza as definitions)
# O .env NUNCA é versionado (está no .gitignore). Este arquivo não pode conter valores reais.
# =====================================================================================

# Senha do usuário "admin" (tag administrator: UI/API de management e provisionador).
RABBITMQ_ADMIN_PASSWORD=

# Senha do usuário "smoke-app" (usado só pelo smoke test; permissões limitadas ao prefixo smoke).
RABBITMQ_SMOKE_APP_PASSWORD=

# Destino GELF do coletor de logs (opcionais; padrão: Graylog do workspace na rede "observability").
# GELF_HOST=graylog
# GELF_PORT=12201
