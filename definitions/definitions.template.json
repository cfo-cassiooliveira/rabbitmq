{
  "users": [
    {
      "name": "admin",
      "password_hash": "__ADMIN_PASSWORD_HASH__",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": ["administrator"],
      "limits": {}
    },
    {
      "name": "smoke-app",
      "password_hash": "__SMOKE_APP_PASSWORD_HASH__",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": [],
      "limits": {}
    }
  ],
  "vhosts": [
    {
      "name": "dev",
      "description": "Local development environment",
      "tags": [],
      "metadata": {
        "description": "Local development environment",
        "tags": [],
        "default_queue_type": "quorum"
      }
    }
  ],
  "permissions": [
    { "user": "admin", "vhost": "dev", "configure": ".*", "write": ".*", "read": ".*" },
    { "user": "smoke-app", "vhost": "dev", "configure": "^smoke(-consumer)?\\.", "write": "^smoke(-consumer)?\\.", "read": "^smoke(-consumer)?\\." }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [],
  "policies": [
    {
      "vhost": "dev",
      "name": "smoke-dlx",
      "pattern": "^smoke-consumer\\.[^.]+$",
      "apply-to": "queues",
      "priority": 0,
      "definition": {
        "dead-letter-exchange": "smoke.dlx",
        "dead-letter-strategy": "at-least-once",
        "overflow": "reject-publish",
        "delivery-limit": 5
      }
    }
  ],
  "exchanges": [
    { "name": "smoke.events", "vhost": "dev", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "smoke.dlx", "vhost": "dev", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    { "name": "smoke-consumer.ping", "vhost": "dev", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } },
    { "name": "smoke-consumer.ping.dlq", "vhost": "dev", "durable": true, "auto_delete": false, "arguments": { "x-queue-type": "quorum" } }
  ],
  "bindings": [
    { "source": "smoke.events", "vhost": "dev", "destination": "smoke-consumer.ping", "destination_type": "queue", "routing_key": "smoke.ping.sent.v1", "arguments": {} },
    { "source": "smoke.dlx", "vhost": "dev", "destination": "smoke-consumer.ping.dlq", "destination_type": "queue", "routing_key": "#", "arguments": {} }
  ]
}
